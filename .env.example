# Copy to .env.local — it is loaded automatically by config/settings.py (python-dotenv).
# Both values are required to boot the app.

# Django signing key. Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-fresh-key

# PostgreSQL connection string — the only engine this board speaks. Either the pooled URI copied from
# the Neon console, as sketched here, or a local cluster created the way README.md "Setting up a local
# PostgreSQL database" describes. Query params pass through to psycopg2 OPTIONS.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
